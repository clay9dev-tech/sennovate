

  <div class="post-card {{ class }}">

    <div class="image">
      {{{ image }}}
    </div>

    <div class="content">
      <div class="tags">
        {{#categories}}
          <div class="tag">{{{ name }}}</div>
        {{/categories}}
      </div>
      {{#post_date}}
        <div class="post-date">{{{.}}}</div>
      {{/post_date}}
      {{#title}}
        <h2 class="title">{{{ . }}}</h2>
      {{/title}}
      
      {{#content}}
        <p class="description">
          {{{ . }}}
        </p>
      {{/content}}

    <div class="wp-block-buttons is-layout-flex wp-block-buttons-is-layout-flex">
      <div class="wp-block-button is-style-text"><a href="{{{href}}}" class="wp-block-button__link wp-element-butto link">Learn more</a></div>
    </div>

    </div>

  </div>