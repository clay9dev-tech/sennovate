<div class="solution-wave-card" style="background-color:{{{background_color}}};border-radius:{{{border_radius}}}px">
    {{{#icon}}}
	<div class="image">
		<figure class="size-medium">
			<img class="size-medium no-thumbnail" src="{{{ icon.url }}}" alt="{{{ icon.alt }}}" />
		</figure>
    </div>
	{{{/icon}}}
    <div class="content">
      {{#heading}}
